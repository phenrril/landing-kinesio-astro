---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const links = [
  { href: '#tratamientos', label: 'Tratamientos' },
  { href: '#equipo', label: 'Equipo' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/video/poster.jpg" />
    <meta name="theme-color" content="#0d1412" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      .orset-footer {
        background: transparent;
        color: inherit;
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
        border-top: 1px solid rgba(127, 127, 127, 0.18);
        padding: 18px clamp(20px, 5vw, 56px);
      }
      .orset-footer-inner {
        max-width: 1280px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 18px 32px;
      }
      .orset-footer .orset-logo {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-weight: 700;
        font-size: 20px;
        letter-spacing: -0.02em;
        color: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-self: start;
      }
      .orset-footer .orset-logo .devby {
        font-family: 'Inter', sans-serif;
        font-weight: 400;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.6;
        margin-right: 8px;
      }
      .orset-footer .orset-logo img {
        height: 46px;
        width: auto;
        display: block;
        margin: -14px 0;
      }
      .orset-footer .orset-tag {
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.75;
        justify-self: center;
        text-align: center;
      }
      .orset-footer .orset-tag .kw {
        font-family: 'Instrument Serif', serif;
        font-style: italic;
        font-size: 15px;
        letter-spacing: 0;
        text-transform: none;
        margin-right: 4px;
      }
      .orset-footer .orset-copy {
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.65;
        justify-self: end;
        text-align: right;
      }
      @media (max-width: 720px) {
        .orset-footer-inner {
          grid-template-columns: 1fr;
          justify-items: center;
        }
        .orset-footer .orset-logo,
        .orset-footer .orset-tag,
        .orset-footer .orset-copy {
          justify-self: center;
          text-align: center;
        }
      }
    </style>
    <noscript>
      <style>
        .reveal { opacity: 1; transform: none; filter: none; }
      </style>
    </noscript>
  </head>
  <body class="text-white antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-3 focus:py-2 focus:text-ink"
      >Saltar al contenido</a
    >

    <header class="fixed inset-x-0 top-0 z-40 flex justify-center px-4">
      <nav
        aria-label="Principal"
        class="mx-auto mt-6 flex w-max max-w-full items-center gap-2 rounded-full border border-line bg-ink/80 px-4 py-2 backdrop-blur-3xl"
      >
        <a href="#" class="mr-2 flex flex-col leading-none" aria-label="Somatic, inicio">
          <span class="text-base font-semibold tracking-[0.2em]">SOMATIC</span>
          <span class="text-[10px] tracking-[0.3em] text-accent">kinesiología</span>
        </a>
        {links.map((l) => (
          <a
            href={l.href}
            class="hidden rounded-full px-3 py-2 text-sm font-semibold text-white/70 transition-all duration-700 ease-fluid hover:bg-raise hover:text-white active:translate-y-px sm:block"
            >{l.label}</a
          >
        ))}
        <!-- en celular el botón va abajo (ver #cta-bar) -->
        <a href="#equipo"
          class="ml-1 hidden cursor-pointer items-center rounded-full bg-accent px-5 py-3 text-base font-semibold text-ink shadow-[0_0_28px_rgb(159_214_192/0.55)] ring-1 ring-white/50 transition-all duration-700 ease-fluid hover:scale-105 hover:shadow-[0_0_40px_rgb(159_214_192/0.8)] active:scale-95 sm:inline-flex"
          >Pedir turno</a
        >
      </nav>
    </header>

    <!-- botón fijo abajo en celular, al alcance del pulgar -->
    <div id="cta-bar" class="fixed inset-x-0 bottom-0 z-40 px-4 pt-3 pb-[max(1rem,env(safe-area-inset-bottom))] sm:hidden">
      <a href="#equipo"
        class="flex min-h-13 w-full cursor-pointer items-center justify-center rounded-2xl bg-accent text-base font-semibold text-ink shadow-[0_8px_32px_rgb(0_0_0/0.5)] ring-1 ring-white/50 active:scale-[0.98]"
        >Pedir turno</a
      >
    </div>

    <!-- ícono de WhatsApp: abre la misma elección Ana / Iván -->
    <a href="#equipo"
      aria-label="Pedir turno por WhatsApp"
      class="fixed right-4 bottom-24 z-40 flex size-14 cursor-pointer items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_8px_32px_rgb(0_0_0/0.45)] ring-1 ring-white/40 transition-transform duration-700 ease-fluid hover:scale-110 active:scale-95 sm:right-6 sm:bottom-6 sm:size-16"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-8 sm:size-9" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
    </a>

    <main id="contenido">
      <slot />
    </main>

    <div class="bg-ink pb-24 sm:pb-0">
      <!-- ORSET FOOTER (marca personal) -->
      <footer class="orset-footer">
        <div class="orset-footer-inner">
          <a href="https://orset.ar" class="orset-logo" target="_blank" rel="noopener" aria-label="dev by orset"><span class="devby" aria-hidden="true">dev by</span><picture><source srcset="/orset-logo.webp" type="image/webp" /><img src="/orset-logo.gif" alt="" width="400" height="220" /></picture></a>
          <div class="orset-tag">
            <span class="kw">OR</span>detectar opciones · <span class="kw">SET</span>poner en marcha
          </div>
          <div class="orset-copy">© {new Date().getFullYear()} orset. all rights reserved</div>
        </div>
      </footer>
    </div>
  </body>
</html>
